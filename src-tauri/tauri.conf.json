{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chord",
  "version": "1.0.0-beta.6",
  "identifier": "com.elva-labs.agent-workbench",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml -p workbench-core --bin agent-workbench-remote && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Chord",
        "width": 1440,
        "height": 900,
        "minWidth": 706,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/remote/*/*"],
    "macOS": {
      "files": { "Resources/bin/awb": "macos/awb" }
    },
    "windows": {
      "wix": { "upgradeCode": "60ccaa4a-c22c-520c-888a-92859857c412" },
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    },
    "linux": {
      "deb": {
        "conflicts": ["agent-workbench"],
        "replaces": ["agent-workbench"],
        "provides": ["agent-workbench"]
      },
      "rpm": { "obsoletes": ["agent-workbench"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
